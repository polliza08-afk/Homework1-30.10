<Window x:Class="WpfImageReader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfImageReader"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="850">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <WrapPanel Margin="10">
            <Button x:Name="btnDownload"
                    Padding="12,6"
                    Content="Завантажити фото" Click="btnDownload_Click"/>

            <TextBox Padding="12,6"
                     Width="400" 
                     Margin="20,0,0,0" 
                     x:Name="txtUrl"/>

            <Button x:Name="btnReadImages"
                    Click="btnReadImages_Click"
                    Padding="12,6"
                    Content="Читання з папки" Width="161"/>
        </WrapPanel>

        <!-- Змінили ListBox на ListView із GridView -->
        <ListView Name="GalleryList" Grid.Row="1" Margin="10">
            <ListView.View>
                <GridView>
                    <!-- Колонки таблиці -->
                    <GridViewColumn Header="Фото" Width="80">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding ImageSource}" Width="50" Height="50" Stretch="UniformToFill"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>

                    <GridViewColumn Header="Назва файлу" 
                                    DisplayMemberBinding="{Binding FileName}"
                                    Width="250"/>
                    <GridViewColumn Header="Розмір" 
                                    DisplayMemberBinding="{Binding FileSizeFormatted}" 
                                    Width="100"/>
                    <GridViewColumn Header="Дата створення" 
                                    DisplayMemberBinding="{Binding CreationTime}" 
                                    Width="150"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>